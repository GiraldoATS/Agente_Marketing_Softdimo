      "id": "d1b2c3d4-0004-4000-8000-000000000003",
      "name": "Leer aprobados",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// Deja solo las publicaciones de HOY para facebook o instagram.\n// Acepta la fecha como 2026-10-26 o 26/10/2026 (formato de Google Sheets en Colombia).\nconst hoy = $now.setZone('America/Bogota').toFormat('yyyy-MM-dd');\n\nconst normalizarFecha = (valor) => {\n  const texto = String(valor ?? '').trim();\n  const dmy = texto.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (dmy) return `${dmy[3]}-${dmy[2].padStart(2, '0')}-${dmy[1].padStart(2, '0')}`;\n  return texto.slice(0, 10);\n};\n\n// Elige la plantilla de Bannerbear según el tipo de publicación.\nconst config = $('Configuración').first().json;\nconst elegirPlantilla = (tipo) => {\n  const t = String(tipo ?? '').toLowerCase();\n  if (t.includes('dolor')) return config.bannerbear_template_dolor;\n  if (t.includes('oferta') || t.includes('social')) return config.bannerbear_template_oferta;\n  return config.bannerbear_template_tip;\n};\n\nreturn $input.all()\n  .filter(item => {\n    const red = String(item.json.red ?? '').toLowerCase().trim();\n    return normalizarFecha(item.json.dia) === hoy && ['facebook', 'instagram'].includes(red);\n  })\n  .map(item => {\n    item.json.plantilla = elegirPlantilla(item.json.tipo);\n    return item;\n  });"
      },
      "id": "d1b2c3d4-0004-4000-8000-000000000004",
      "name": "Filtrar publicaciones de hoy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
